<?xml version="1.0" encoding="utf-8"?>
<!-- ESI Agent launcher foreground — ink & signal -->
<!--
  Composition (inside the adaptive-icon safe zone, r≈33 of the 108 viewport):
    soft indigo glow → white ink bubble with tail → indigo signal waves →
    teal spark on a light halo.
  All shapes are <path>: VectorDrawable has no <circle> element.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft indigo glow behind the bubble (fades out before the mask edge) -->
    <path android:pathData="M54,52 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="40"
                android:startColor="#8C4B4FD6"
                android:endColor="#004B4FD6" />
        </aapt:attr>
    </path>

    <!-- Ink bubble: rounded speech bubble with a tail (clean white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,34 h28 a10,10 0 0 1 10,10 v20 a10,10 0 0 1 -10,10 h-14 l-9,11 -1,-11 h-4 a10,10 0 0 1 -10,-10 V44 a10,10 0 0 1 10,-10 z" />

    <!-- Signal waves — the assistant's signal, drawn inside the ink -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#4B4FD6"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M40,46 Q54,36 68,46 M42,54 Q56,44 70,54 M44,62 Q58,52 72,62" />

    <!-- Spark: teal star on a light indigo halo, pinned to the bubble corner -->
    <path
        android:fillColor="#AAB8FF"
        android:pathData="M66.5,34 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 z" />
    <path
        android:fillColor="#00696E"
        android:pathData="M72,29.5 l2.2,5.5 5.5,2.2 -5.5,2.2 -2.2,5.5 -2.2,-5.5 -5.5,-2.2 5.5,-2.2 z" />

</vector>
